# 이 파일을 .env로 복사해서 값을 채운다. (.env는 git에 커밋하지 않음)
# EAS 클라우드 빌드에서는 .env가 업로드되지 않으므로 같은 값을 `eas env:create`로 등록해야 함.

# Supabase — anon 키는 공개 전제(RLS로 보호). 서비스 롤 키는 절대 여기 넣지 말 것.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps Platform — 지도 SDK + Directions/Places/Geocoding 호출에 사용 (앱 번들에 포함됨 → GCP 콘솔에서 API 제한 필수)
MAPS_PLATFORM_API_KEY=

# 네이티브 로그인 플러그인용 (app.config.js에서 주석 처리됨, 현재 미사용)
KAKAO_NATIVE_APP_KEY=
GOOGLE_WEB_CLIENT_ID=
